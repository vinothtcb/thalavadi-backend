PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/thalavadi
JWT_SECRET=myrandomsecret9284kdjfoo3
JWT_EXPIRES_IN=30d
OTP_EXPIRY_MINUTES=5

# Login is by email — OTP is always sent by email (Nodemailer, open source),
# using any SMTP server. Free options: Brevo (300/day free), Resend
# (100/day free), or Gmail SMTP with an App Password. If left blank, OTPs
# are just logged to the console — useful for local testing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@thalavadi.local
