PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/thalavadi
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=30d
OTP_EXPIRY_MINUTES=5

# Login is by email — OTP is sent via Brevo's HTTPS transactional email
# API (not SMTP). This matters on hosts like Railway that block outbound
# SMTP ports on free/hobby plans — the HTTPS API has no such restriction.
# Get BREVO_API_KEY from Brevo dashboard → SMTP & API → API Keys tab
# (a different credential from the SMTP key). Free tier: 300 emails/day.
# If left blank, OTPs are just logged to the console — useful for local testing.
BREVO_API_KEY=
SMTP_FROM=no-reply@thalavadi.local
